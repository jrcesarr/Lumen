DEBUG=true
# A API conecta como app_backend (sem BYPASSRLS); as migrations, como um usuario com DDL.
DATABASE_URL=postgresql+asyncpg://app_backend:app_backend@localhost:5432/lumen
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lumen
SUPABASE_URL=http://localhost:54321
# So em dev: aceita tokens HS256. Em producao, deixe vazio e use o JWKS.
SUPABASE_JWT_SECRET=troque-por-um-segredo-local-com-32-bytes-ou-mais
